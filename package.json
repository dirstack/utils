{
  "name": "@dirstack/utils",
  "version": "0.0.0-development",
  "description": "A lightweight set of utilities",
  "keywords": [
    "helpers",
    "typescript",
    "utilities",
    "utils"
  ],
  "homepage": "https://github.com/dirstack/utils#readme",
  "bugs": "https://github.com/dirstack/utils/issues",
  "license": "MIT",
  "author": {
    "name": "Piotr Kulpinski",
    "email": "piotr@kulpinski.pl",
    "url": "https://kulpinski.pl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirstack/utils.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*/*.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prebuild": "bun run clean",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write .",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^2.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@dirstack/kodeks": "1.8.3",
    "@types/bun": "^1.2.21",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "^0.27.3",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
